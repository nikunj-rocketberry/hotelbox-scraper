# --- Postgres (matches ../docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5439
DB_USER=hotelbox
DB_PASSWORD=hotelbox
DB_NAME=hotelbox

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MinIO ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hotel-media
# Public base URL stored on media rows (point this at a reverse proxy / MinIO public endpoint in prod)
MINIO_PUBLIC_URL=http://localhost:9000/hotel-media

# --- API process ---
PORT=3000

# --- Scraper ---
EXPEDIA_BASE_URL=https://www.expedia.co.in
# Search stay dates used for hotel search URLs (rooms are content-only, dates just need to be valid/future)
SEARCH_STAY_NIGHTS=6
# Headless=false is useful while developing/verifying selectors
PLAYWRIGHT_HEADLESS=true
# Size of the reused BrowserContext pool *per worker process* (session reuse —
# contexts are checked out/cleared/checked back in across jobs instead of being
# recreated per job). Keep in step with WORKER_CONCURRENCY: this is the ceiling
# on how many jobs can hold a context at once.
PLAYWRIGHT_MAX_CONTEXTS=5
# Pagination ceiling per city hotel-list search. Raise this to pull more hotels per city.
HOTEL_LIST_MAX_PAGES=50
# Skip re-scraping (and re-enqueueing) a hotel already synced within this many
# days — the caching/dedup layer for repeat crawls of the same region. 0 disables it.
RESCRAPE_FRESHNESS_DAYS=14
# Abort image/font/media subresource requests (we only ever read src attributes,
# never pixel data) — cuts bandwidth/CPU per page load. Set false if you need to
# eyeball pages (PLAYWRIGHT_HEADLESS=false) while debugging selectors.
PLAYWRIGHT_BLOCK_RESOURCES=true
# Random delay before every navigation, so jobs the rate limiter releases
# together don't all hit Expedia in the same instant. This trades a small
# amount of raw throughput for smoother load — set both to 0 to disable.
NAV_JITTER_MIN_MS=200
NAV_JITTER_MAX_MS=800
# Fleet-wide token bucket (Redis-backed — shared across ALL worker processes,
# not per-process): the actual enforced cap on navigations/hour, refilling
# continuously toward RATE_PER_HOUR with BURST_CAPACITY tokens bankable for
# short bursts (e.g. a city with a long hotel list). This is what replaces
# BullMQ's own limiter as the precise pacing mechanism — that one just caps
# job *starts* per window and can release its whole `max` at once.
TRAFFIC_SHAPER_ENABLED=true
TRAFFIC_SHAPER_RATE_PER_HOUR=1000
TRAFFIC_SHAPER_BURST_CAPACITY=5

# --- BullMQ worker tuning ---
# Concurrent jobs processed per worker process, per queue. Start conservative;
# real ceiling is Expedia's bot tolerance, not your hardware. Tune empirically.
WORKER_CONCURRENCY=5
# Max jobs started per RATE_LIMIT_DURATION_MS, per queue, across all workers sharing the queue.
RATE_LIMIT_MAX=20
RATE_LIMIT_DURATION_MS=60000
# Retries per job before it lands in the failed set (see Bull Board at /admin/queues).
JOB_ATTEMPTS=5
# Exponential backoff base delay: attempt N waits ~JOB_BACKOFF_BASE_MS * 2^(N-1).
JOB_BACKOFF_BASE_MS=30000

# --- Batch ingestion (production-grade DB writes: one SQL round trip per batch, not per hotel) ---
# Flush as soon as this many scraped hotels are buffered...
INGEST_BATCH_SIZE=20
# ...or after this many ms since the first item in the current batch, whichever comes first.
INGEST_BATCH_MAX_WAIT_MS=4000

# --- Anti-bot circuit breaker (shared across ALL workers via Redis) ---
# On a detected block (429/403/CAPTCHA/rate-limit page), every worker stops
# navigating for this long before trying again.
ANTI_BOT_COOLDOWN_MS=1800000
