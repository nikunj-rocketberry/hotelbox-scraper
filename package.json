{
  "name": "hotelbox-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Expedia hotel content scraper: NestJS + Playwright + BullMQ, ingesting into Postgres and MinIO",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/worker.main.js",
    "start:worker:dev": "nest start --watch --entryFile worker.main",
    "playwright:install": "playwright install chromium --with-deps",
    "playwright:inspect": "ts-node -r tsconfig-paths/register scripts/inspect.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/database/data-source.ts",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "seed:geo": "ts-node -r tsconfig-paths/register scripts/seed-geo.ts",
    "scrape:region": "ts-node -r tsconfig-paths/register scripts/trigger-region.ts",
    "scrape:regions": "ts-node -r tsconfig-paths/register scripts/trigger-regions.ts",
    "cooldown:reset": "ts-node -r tsconfig-paths/register scripts/reset-cooldown.ts",
    "queue:clear": "ts-node -r tsconfig-paths/register scripts/clear-queues.ts",
    "cities:clear": "ts-node -r tsconfig-paths/register scripts/clear-cities.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/typeorm": "^10.0.2",
    "@bull-board/api": "^9.8.0",
    "@bull-board/express": "^9.8.0",
    "bullmq": "^5.13.2",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "minio": "^8.0.1",
    "pg": "^8.13.0",
    "playwright": "^1.48.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@types/node": "^22.7.5",
    "@types/uuid": "^10.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
